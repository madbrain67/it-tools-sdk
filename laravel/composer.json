{
    "name": "plateformweb/it-tools-laravel",
    "description": "Integration Laravel de l'API IT-Tools : ServiceProvider, Facade ItTools et transport sur le client HTTP de Laravel (Http::fake compatible).",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "it-tools", "api", "sdk", "pdf", "cerfa"],
    "require": {
        "php": ">=8.1",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "plateformweb/it-tools-php": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Plateformweb\\ItToolsLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plateformweb\\ItToolsLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Plateformweb\\ItToolsLaravel\\ItToolsServiceProvider"
            ],
            "aliases": {
                "ItTools": "Plateformweb\\ItToolsLaravel\\Facades\\ItTools"
            }
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php",
            "options": {"symlink": false, "versions": {"plateformweb/it-tools-php": "1.0.0"}}
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
