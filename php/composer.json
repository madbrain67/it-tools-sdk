{
    "name": "plateformweb/it-tools-php",
    "description": "SDK PHP pour l'API IT-Tools : outils PDF, CERFA, conversion de documents, QR codes et outils developpeur. Sans dependance, utilisable en objet ou en procedural.",
    "type": "library",
    "license": "MIT",
    "keywords": ["it-tools", "api", "sdk", "pdf", "cerfa", "qrcode", "developer-tools"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-fileinfo": "Detection automatique du type MIME des fichiers envoyes"
    },
    "autoload": {
        "psr-4": {
            "Plateformweb\\ItTools\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Plateformweb\\ItTools\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --exclude-group live",
        "test:live": "phpunit --group live"
    },
    "minimum-stability": "stable"
}
